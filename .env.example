# AI is disabled until account free credits and disabled overages are verified.
COACH_ENABLED=false
NEBIUS_FREE_CREDITS_VERIFIED=false
NEBIUS_PAID_OVERAGES_DISABLED=false
NEBIUS_CREDITS_EXPIRE_AT=
NEBIUS_API_KEY=
# Run pnpm models for exact available IDs; prefer an available Nano model.
NEBIUS_MODEL=
# Lifetime request allocation the FREE grant covers at worst-case token usage.
# Include provider prices and preserve a judging reserve. Errors consume a slot.
COACH_RESERVED_REQUESTS=0
COACH_DAILY_REQUESTS=40
COACH_BUDGET_ID=touchline-hackathon-v1
# Verified free-tier persistent Redis ledger; no inference without this ledger.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Draft Duel server settings. Persistent store must be outside dist/.
# HOST=0.0.0.0
# MULTIPLAYER_STORE=/persistent/touchline/rooms.json
